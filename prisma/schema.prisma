// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  CITIZENSHIP
  LICENSE
  NATIONAL_ID
}

enum VehicleStatus {
  IN_STOCK
  SOLD
}

enum PaymentType {
  CASH
  FINANCE
  EXCHANGE
  CREDIT
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id               String   @id @default(uuid())
  fullName         String?
  phone            String   @unique
  email            String?  @unique
  passwordHash     String?
  address          String?
  bio              String?
  avatarUrl        String?
  gender           Gender?
  dobAd            String?
  dobBs            String?
  
  // Documents (Multi-KYC)
  citizenshipVerified Boolean @default(false)
  citizenshipNumber   String?
  citizenshipFront    String?
  citizenshipBack     String?
  
  licenseVerified     Boolean @default(false)
  licenseNumber       String?
  licenseFront        String?
  licenseBack         String?
  
  nationalIdVerified  Boolean @default(false)
  nationalIdNumber    String?
  nationalIdFront     String?
  nationalIdBack      String?
  
  ocrVerified         Boolean  @default(false) // Legacy flag, keep for backwards compatibility if needed
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sales            SalesTransaction[]
  services         ServiceRecord[]
}

model OtpVerification {
  id         String   @id @default(uuid())
  identifier String   // email or phone
  hashedOtp  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model VehicleInventory {
  id              String   @id @default(uuid())
  vin             String   @unique // Chassis No
  engineNo        String   @unique
  category        String   // e.g., Motorcycle, Scooter, Power Product
  modelName       String
  cc              Int
  color           String
  
  purchasePrice   Float
  sellingPrice    Float
  purchaseDate    DateTime
  purchaseMethod  String
  rtoStatus       String?
  
  status          VehicleStatus @default(IN_STOCK)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  saleTransaction SalesTransaction?
  services        ServiceRecord[]
}

model OfficialLetter {
  id              String   @id @default(uuid())
  referenceNo     String   @unique
  letterType      String
  recipientName   String
  recipientDesignation String?
  recipientBranch String?
  
  amountNpr       Float?
  
  englishContent  String?
  nepaliContent   String   @db.Text
  
  createdBy       String   // Staff ID
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SalesTransaction {
  id              String   @id @default(uuid())
  invoiceNo       String   @unique
  
  vehicleId       String   @unique
  vehicle         VehicleInventory @relation(fields: [vehicleId], references: [id])
  
  customerId      String
  customer        User     @relation(fields: [customerId], references: [id])
  
  paymentType     PaymentType
  finalAmount     Float
  commission      Float    // Auto-calculate 1.5%
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ServiceRecord {
  id              String   @id @default(uuid())
  
  vehicleId       String
  vehicle         VehicleInventory @relation(fields: [vehicleId], references: [id])
  
  customerId      String
  customer        User     @relation(fields: [customerId], references: [id])
  
  odometerKm      Int
  serviceType     String
  status          ServiceStatus @default(PENDING)
  mechanicNotes   String?  @db.Text
  totalBill       Float
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductCatalog {
  id          String   @id
  name        String
  category    String   // MOTORCYCLES, AUTOMOBILES, POWER_PRODUCTS
  price       Float
  imageUrl    String
  description String?
  specs       Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
